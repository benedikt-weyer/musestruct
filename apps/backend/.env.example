# Backend example environment
# Copy this file to apps/backend/.env and fill in the provider credentials you use.

# Database
# You can either set DATABASE_URL directly, or let the backend assemble it from POSTGRES_*.
DATABASE_URL=postgresql://musestruct:change-me@localhost:5432/musestruct
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=musestruct
POSTGRES_USER=musestruct
POSTGRES_PASSWORD=change-me
DATABASE_CONNECT_MAX_ATTEMPTS=30
DATABASE_CONNECT_RETRY_DELAY_SECS=2

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=debug

# Qobuz
# Optional unless you use the Qobuz integration.
QOBUZ_APP_ID=
QOBUZ_SECRET=

# Spotify
# Optional unless you use the Spotify integration.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional. If unset, the backend derives the callback URL from the request host.
# Example: http://localhost:8080/api/streaming/spotify/callback
SPOTIFY_REDIRECT_URI=

# Tidal
# Optional unless you use the Tidal integration.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
# Optional. Only set this if your Tidal app configuration requires it.
TIDAL_CLIENT_UNIQUE_KEY=
# Optional. If unset, the backend derives the callback URL from the request host.
# Example: http://localhost:8080/api/streaming/tidal/callback
TIDAL_REDIRECT_URI=
# Optional market/country code used for Tidal catalog requests.
TIDAL_COUNTRY_CODE=US
